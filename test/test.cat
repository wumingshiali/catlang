; CatLang Test - Basic functionality test

struct Point [
    x: f64
    y: f64
]

fn add(a: i32, b: i32) -> i32 [
    return a + b
]

[main
    ; Simple variables
    new x<i32> = 10
    new y<i32> = 20
    new sum<i32> = add(x, y)
    print("Sum: {}\n", sum)

    ; If-else
    if (x < y) [
        print("x < y\n")
    ]

    ; While loop
    new i<i32> = 0
    while (i < 3) [
        print("While: {}\n", i)
        i = i + 1
    ]

    print("Test passed!\n")
]
